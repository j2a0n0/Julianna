# Copy this file to .docker/.env before running Docker Compose.
# Generate secrets independently; never commit the resulting .env file.
#
#   openssl rand -base64 32   # JULIANNA_APP_KEY (prefix output with base64:)
#   openssl rand -hex 32      # database passwords

JULIANNA_ENV=local
JULIANNA_APP_URL=http://localhost:8080
JULIANNA_APP_DIR=
JULIANNA_APP_KEY=base64:replace-with-32-random-bytes
JULIANNA_SESSION_SECURE=false
JULIANNA_BIND_ADDRESS=127.0.0.1
JULIANNA_PORT=8080

# Release identity. Production must use an HTTPS source URL for the exact tag
# represented by JULIANNA_VERSION/JULIANNA_COMMIT.
JULIANNA_VERSION=1.0.0-dev
JULIANNA_COMMIT=unknown
JULIANNA_SOURCE_URL=

JULIANNA_DB_DATABASE=julianna
JULIANNA_DB_USER=julianna
JULIANNA_DB_PASSWORD=replace-with-a-random-password
JULIANNA_DB_ROOT_PASSWORD=replace-with-a-different-random-password

JULIANNA_SITENAME=Julianna
JULIANNA_LANGUAGE=en-US
JULIANNA_DEFAULT_TIMEZONE=Europe/Zurich
JULIANNA_REGISTRATION_ENABLED=true
JULIANNA_LOG_CHANNELS=stderr

# Public registration is intentionally unavailable in production until these
# values describe a working SMTP service.
JULIANNA_EMAIL_RETURN=
JULIANNA_EMAIL_USE_SMTP=false
JULIANNA_EMAIL_SMTP_HOSTS=
JULIANNA_EMAIL_SMTP_AUTH=true
JULIANNA_EMAIL_SMTP_USERNAME=
JULIANNA_EMAIL_SMTP_PASSWORD=
JULIANNA_EMAIL_SMTP_AUTO_TLS=true
JULIANNA_EMAIL_SMTP_SECURE=
JULIANNA_EMAIL_SMTP_PORT=

# Agent work is disabled until all three server-side values are configured.
# Use either JULIANNA_AI_API_KEY or a mounted JULIANNA_AI_API_KEY_FILE.
JULIANNA_AI_PROVIDER=
JULIANNA_AI_MODEL=
JULIANNA_AI_REQUESTS_PER_HOUR=20
JULIANNA_AI_API_KEY=

# Optional live, read-only web search (separate Brave Search API key).
JULIANNA_WEB_SEARCH_API_KEY=
