#
# This environment file is used for our testing framework
# It is not to be used for development
#

## Minimum Configuration, these are required for installation

JULIANNA_ENV = testing
JULIANNA_APP_URL = 'https://julianna-dev'                             # Base URL, only needed for subfolder installation
JULIANNA_APP_DIR = ''                             # Base of application without trailing slash (used for cookies), e.g, /julianna
JULIANNA_DEBUG = true                                # Debug flag

# Database
JULIANNA_DB_HOST=julianna-db
JULIANNA_DB_USER=root
JULIANNA_DB_PASSWORD=julianna
JULIANNA_DB_DATABASE=julianna_test
JULIANNA_DB_PORT=3306

## Optional Configuraiton, you may ommit these from your .env file

## Default Settings
JULIANNA_SITENAME = 'Julianna'                         # Name of your site, can be changed later
JULIANNA_LANGUAGE = 'en-US'                            # Default language
JULIANNA_DEFAULT_TIMEZONE = 'Europe/Zurich'      # Set default timezone
JULIANNA_ENABLE_MENU_TYPE = false                      # Enable to specifiy menu on aproject by project basis
JULIANNA_APP_KEY = 'testing-julianna-app-key-00000001'
JULIANNA_SESSION_EXPIRATION = 480                      # Idle timeout in minutes
JULIANNA_LOG_PATH = ''                                # Default Log Path (including filename), if not set /logs/error.log will be used

## Look & Feel, these settings are available in the UI and can be overwritten there.
JULIANNA_LOGO_PATH = '/dist/images/logo.svg'                # Default logo path, can be changed later
JULIANNA_PRINT_LOGO_URL = '/dist/images/logo.png'           # Default logo URL use for printing (must be jpg or png format)
JULIANNA_DEFAULT_THEME = 'default'                     # Default theme
JULIANNA_PRIMARY_COLOR = '#006d9f'                     # Primary Theme color
JULIANNA_SECONDARY_COLOR = '#81B1A8'                   # Secondary Theme Color
JULIANNA_KEEP_THEME = true                             # Keep theme and language from previous user for login screen

## Fileuploads

# Local File Uploads
JULIANNA_USER_FILE_PATH = 'userfiles/'                 # Local relative path to store uploaded files (if not using S3)
JULIANNA_DB_BACKUP_PATH = 'backupdb/'                  # Local relative path to store backup files, need permission to write

# S3 File Uploads
JULIANNA_USE_S3 = false                                # Set to true if you want to use S3 instead of local files
JULIANNA_S3_KEY = 'AKIAIOSFODNN7EXAMPLE'                                   # S3 Key, hardcoded in s3ninja
JULIANNA_S3_SECRET = 'wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY'            # S3 Secret, hardcoded in s3ninja
JULIANNA_S3_BUCKET = 'julianna'                       # Your S3 bucket
JULIANNA_S3_USE_PATH_STYLE_ENDPOINT = true            # Sets the endpoint style: false => https://[bucket].[endpoint] ; true => https://[endpoint]/[bucket]
JULIANNA_S3_REGION = 'eu-west-1'                                # S3 region
JULIANNA_S3_FOLDER_NAME = ''                           # Foldername within S3 (can be emtpy)
JULIANNA_S3_END_POINT = "http://s3ninja:9000"               # S3 EndPoint S3 Compatible (https://sfo2.digitaloceanspaces.com)

## Email
JULIANNA_EMAIL_RETURN = 'julianna@test.local'                             # Return email address, needs to be valid email address format
JULIANNA_EMAIL_USE_SMTP = true                        # Use SMTP? If set to false, the default php mail() function will be used
JULIANNA_EMAIL_SMTP_HOSTS = 'maildev'                         # SMTP host
JULIANNA_EMAIL_SMTP_AUTH = false                        # SMTP authentication required
JULIANNA_EMAIL_SMTP_USERNAME = ''                      # SMTP username
JULIANNA_EMAIL_SMTP_PASSWORD = ''                      # SMTP password
JULIANNA_EMAIL_SMTP_AUTO_TLS = true                    # SMTP Enable TLS encryption automatically if a server supports it
JULIANNA_EMAIL_SMTP_SECURE = ''                        # SMTP Security protocol (usually one of: TLS, SSL, STARTTLS)
JULIANNA_EMAIL_SMTP_SSLNOVERIFY = true                # SMTP Allow insecure SSL: Don't verify certificate, accept self-signed, etc.
JULIANNA_EMAIL_SMTP_PORT = '465'                          # Port (usually one of 25, 465, 587, 2526)

## Ldap
JULIANNA_LDAP_USE_LDAP = false                         # Set to true if you want to use LDAP
JULIANNA_LDAP_LDAP_TYPE = 'OL'                         # Select the correct directory type. Currently Supported: OL - OpenLdap, AD - Active Directory
JULIANNA_LDAP_HOST = ''                                # FQDN
JULIANNA_LDAP_PORT = 389                               # Default Port
JULIANNA_LDAP_DN = ''                                  # Location of users, example: CN=users,DC=example,DC=com

                                                    # Julianna->Ldap attribute mapping
JULIANNA_LDAP_KEYS = "{\"username\":\"uid\",\"groups\":\"memberOf\",\"email\":\"mail\",\"firstname\":\"displayname\",\"lastname\":\"\",\"phonenumber\":\"telephoneNumber\"}"

# For AD use these default attributes
# JULIANNA_LDAP_KEYS = "{
#        \"username\":\"cn\",
#        \"groups\":\"memberOf\",
#        \"email\":\"mail\",
#        \"firstname\":\"givenName\",
#        \"lastname\":\"sn\",
#        \"phonenumber\":\"telephoneNumber\"
#      }"

JULIANNA_LDAP_DEFAULT_ROLE_KEY = 20;                   # Default Julianna Role on creation. (set to editor)

# Default role assignments upon first login.
# (Optional) Can be updated later in user settings for each user
JULIANNA_LDAP_GROUP_ASSIGNMENT = "{\"5\": {\"ltRole\":\"readonly\",\"ldapRole\":\"readonly\"},\"10\": {\"ltRole\":\"commenter\",\"ldapRole\":\"commenter\"},\"20\": {\"ltRole\":\"editor\",\"ldapRole\":\"editor\"},\"30\": {\"ltRole\":\"manager\",\"ldapRole\":\"manager\"},\"40\": {\"ltRole\":\"admin\",\"ldapRole\":\"administrators\"},\"50\": {\"ltRole\":\"owner\",\"ldapRole\":\"administrators\"}}"


## OpenID Connect
# required
JULIANNA_OIDC_ENABLE = false
JULIANNA_OIDC_CLIEND_ID =
JULIANNA_OIDC_CLIEND_SECRET =

# required - the url for your provider (examples down below)
#JULIANNA_OIDC_PROVIDER_URL =

# optional - these will be read from the well-known configuration if possible
#JULIANNA_OIDC_AUTH_URL_OVERRIDE =
#JULIANNA_OIDC_TOKEN_URL_OVERRIDE =
#JULIANNA_OIDC_JWKS_URL_OVERRIDE =
#JULIANNA_OIDC_USERINFO_URL_OVERRIDE =

# optional - override the public key for RSA validation
#JULIANNA_OIDC_CERTIFICATE_STRING =
#JULIANNA_OIDC_CERTIFICATE_FILE =

# optional - override the requested scopes
#JULIANNA_OIDC_SCOPES =

# optional - override the keys used for these fields
#JULIANNA_OIDC_FIELD_EMAIL =
#JULIANNA_OIDC_FIELD_FIRSTNAME =
#JULIANNA_OIDC_FIELD_LASTNAME =

## OpenID Connect setting for github
#JULIANNA_OIDC_PROVIDER_URL = https://token.actions.githubusercontent.com/
#JULIANNA_OIDC_AUTH_URL_OVERRIDE = https://github.com/login/oauth/authorize
#JULIANNA_OIDC_TOKEN_URL_OVERRIDE = https://github.com/login/oauth/access_token
#JULIANNA_OIDC_USERINFO_URL_OVERRIDE = https://api.github.com/user,https://api.github.com/user/emails
#JULIANNA_OIDC_SCOPES = user:email
#JULIANNA_OIDC_FIELD_EMAIL = 0.email

JULIANNA_RATELIMIT_GENERAL = 50000
JULIANNA_RATELIMIT_AUTH = 50000
JULIANNA_RATELIMIT_API = 50000

# Cache Configuration for testing (use file cache instead of Redis)
JULIANNA_USE_REDIS=false
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
