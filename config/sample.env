# This is a sample configuration file with all possible configuration options.
# If you don't want to maintain a file like this you can pass in all variables via Server Variables

## Minimum Configuration, these are required for installation

JULIANNA_ENV = 'production'                            # Use 'local' or 'testing' only outside production
JULIANNA_APP_URL = ''                                  # Public application URL, including https:// in production
JULIANNA_APP_DIR = ''                                  # Base of application without trailing slash (used for cookies), e.g, /julianna
JULIANNA_SOURCE_URL = ''                               # Public HTTPS URL for the exact source revision deployed (required in production)
JULIANNA_VERSION = '1.0.0-dev'                         # Application version displayed in About and release metadata
JULIANNA_COMMIT = 'unknown'                            # Git commit included in this deployment

JULIANNA_DEBUG = 0                                     # Debug flag

# JULIANNA_PERMISSIONS_ENFORCE = true                  # Enforce #[RequiresPermission] denials (403 / RPC -32001). Set false for audit/log-only mode.

# Database
JULIANNA_DB_HOST = 'localhost'                         # Database host
JULIANNA_DB_USER = ''                                  # Database username
JULIANNA_DB_PASSWORD = ''                              # Database password
JULIANNA_DB_DATABASE = ''                              # Database name
JULIANNA_DB_PORT = '3306'                              # Database port (3306 for MySQL, 5432 for PostgreSQL)

## Database Driver Selection (Advanced)
# JULIANNA_DB_DEFAULT_CONNECTION = 'mysql'             # Options: 'mysql', 'pgsql'. Default: mysql

## PostgreSQL-specific options (only when JULIANNA_DB_DEFAULT_CONNECTION = 'pgsql')
# JULIANNA_DB_SCHEMA = 'public'                        # PostgreSQL schema (default: public)
# JULIANNA_DB_SSLMODE = 'prefer'                       # SSL mode: disable, allow, prefer, require, verify-ca, verify-full

## Database Connection Management (Advanced)
JULIANNA_DB_PERSISTENT_CONNECTIONS = true              # Enable persistent database connections for connection pooling
JULIANNA_DB_MAX_CONNECTIONS = 100                      # Maximum number of database connections in pool
JULIANNA_DB_MIN_CONNECTIONS = 1                        # Minimum number of database connections in pool
JULIANNA_DB_CONNECTION_TIMEOUT = 30                    # Database connection timeout in seconds
JULIANNA_DB_IDLE_TIMEOUT = 300                         # Database idle timeout in seconds (5 minutes)

## Session Management
JULIANNA_APP_KEY = ''                                  # Required: at least 32 random bytes; generate with `openssl rand -base64 32` and prefix with `base64:`
JULIANNA_SESSION_EXPIRATION = 480                      # Session idle timeout in MINUTES. Forwarded directly to Laravel's `session.lifetime` config (which is in minutes, not seconds). 480 minutes = 8 hours. The Helm chart (`helm/values.yaml` -> `app.session.expiration`) must use the same unit.
## Session & Security
JULIANNA_SESSION_SECURE = true                         # Required in production; set false only for local HTTP development
# JULIANNA_HSTS_ENABLED=false                           # Set to true to enable HSTS header (auto-enabled on HTTPS)

## Optional Configuration, you may omit these from your .env file

## Default Settings
JULIANNA_SITENAME = 'Julianna'                         # Name of your site, can be changed later
JULIANNA_LANGUAGE = 'en-US'                            # Default language
JULIANNA_DEFAULT_TIMEZONE = 'Europe/Zurich'            # Set default timezone
JULIANNA_REGISTRATION_ENABLED = true                   # Public signup; production signup also requires working SMTP

## Agent (optional; server-side only, disabled until provider/model/key are set)
JULIANNA_AI_PROVIDER = ''                               # openai, anthropic, deepseek, or kimi
JULIANNA_AI_MODEL = ''                                  # Model identifier from the selected provider
JULIANNA_AI_REQUESTS_PER_HOUR = 20                     # Per-user web request budget (1-100); replays do not count
JULIANNA_AI_API_KEY = ''                                # Secret API key; never expose in client-side settings or logs
JULIANNA_WEB_SEARCH_API_KEY = ''                         # Optional Brave Search API key; enables read-only live web search
JULIANNA_LOG_PATH = ''                                 # Default Log Path (including filename), if not set /logs/error.log will be used
JULIANNA_LOG_CHANNELS = 'single,syslog'                # Logging channels (comma-separated): single, syslog, sentry, stderr. Add sentry only after configuring a DSN; use stderr for containers.
JULIANNA_LOG_DEPRECATIONS = 0                          # Write PHP deprecation notices to logs/deprecations.log (off by default; also enabled by JULIANNA_DEBUG)
JULIANNA_DISABLE_LOGIN_FORM = false                    # If true then don't show the login form (useful only if additional auth method[s] are available)
#JULIANNA_TRUSTED_PROXIES = '127.0.0.1,REMOTE_ADDR'    # Set trusted proxy ips. Can be used to restrict access or define access from certain proxies only. Default is access from anywhere

## Sentry (optional; disabled until a DSN is supplied and "sentry" is added to JULIANNA_LOG_CHANNELS)
JULIANNA_SENTRY_DSN = ''

## Look & Feel, these settings are available in the UI and can be overwritten there.
JULIANNA_LOGO_PATH = '/dist/images/logo.svg'           # Default logo path, can be changed later
JULIANNA_PRINT_LOGO_URL = '/dist/images/logo.png'      # Default logo URL use for printing (must be jpg or png format)
JULIANNA_DEFAULT_THEME = 'default'                     # Default theme
JULIANNA_PRIMARY_COLOR = '#006d9f'                     # Primary Theme color
JULIANNA_SECONDARY_COLOR =' #00a886'                   # Secondary Theme Color

## File Uploads

# Local File Uploads
JULIANNA_USER_FILE_PATH = 'userfiles/'                 # Local relative path to store uploaded files (if not using S3)
JULIANNA_DB_BACKUP_PATH = 'backupdb/'                  # Local relative path to store backup files, need permission to write

# S3 File Uploads
JULIANNA_USE_S3 = false                                # Set to true if you want to use S3 instead of local files
JULIANNA_S3_KEY = ''                                   # S3 Key
JULIANNA_S3_SECRET = ''                                # S3 Secret
JULIANNA_S3_BUCKET = ''                                # Your S3 bucket
JULIANNA_S3_USE_PATH_STYLE_ENDPOINT = false            # Sets the endpoint style: false => https://[bucket].[endpoint] ; true => https://[endpoint]/[bucket]
JULIANNA_S3_REGION = ''                                # S3 region
JULIANNA_S3_FOLDER_NAME = ''                           # Foldername within S3 (can be empty)
JULIANNA_S3_END_POINT = null                           # S3 EndPoint S3 Compatible (https://sfo2.digitaloceanspaces.com)

## Firebase Cloud Messaging (optional; disabled while either value is empty)
JULIANNA_PUSH_FCM_CREDENTIALS_PATH = ''                # Absolute path to a Firebase service-account JSON file
JULIANNA_PUSH_FCM_PROJECT_ID = ''                      # Firebase project id

## Email
JULIANNA_EMAIL_RETURN = ''                             # Return email address, needs to be valid email address format
JULIANNA_EMAIL_USE_SMTP = false                        # Use SMTP? If set to false, the default php mail() function will be used
JULIANNA_EMAIL_SMTP_HOSTS = ''                         # SMTP host
JULIANNA_EMAIL_SMTP_AUTH = true                        # SMTP authentication required
JULIANNA_EMAIL_SMTP_USERNAME = ''                      # SMTP username
JULIANNA_EMAIL_SMTP_PASSWORD = ''                      # SMTP password
JULIANNA_EMAIL_SMTP_AUTO_TLS = true                    # SMTP Enable TLS encryption automatically if a server supports it
JULIANNA_EMAIL_SMTP_SECURE = ''                        # SMTP Security protocol (usually one of: TLS, SSL, STARTTLS)
JULIANNA_EMAIL_SMTP_SSLNOVERIFY = false                # SMTP Allow insecure SSL: Don't verify certificate, accept self-signed, etc.
JULIANNA_EMAIL_SMTP_PORT = ''                          # Port (usually one of 25, 465, 587, 2526)

## Legacy identity-provider settings
# LDAP and OIDC login are intentionally disabled in Julianna 1.0. The settings
# below are retained only as internal implementation compatibility and do not
# bypass Julianna password, approval, and mandatory MFA authentication.
## LDAP
JULIANNA_LDAP_USE_LDAP = false                         # Set to true if you want to use LDAP
JULIANNA_LDAP_LDAP_DOMAIN = ''                         # Domain name after username@ so users can login without domain definition
JULIANNA_LDAP_LDAP_TYPE = 'OL'                         # Select the correct directory type. Currently Supported: OL - OpenLdap, AD - Active Directory
JULIANNA_LDAP_HOST = ''                                # FQDN
JULIANNA_LDAP_PORT = 389                               # Default Port
JULIANNA_LDAP_URI = ''                                 # LDAP URI as alternative to hostname and port. Uses ldap://hostname:port
JULIANNA_LDAP_DN = ''                                  # Location of users, example: CN=users,DC=example,DC=com
                                                   # Julianna->Ldap attribute mapping
JULIANNA_LDAP_KEYS="{
        \"username\":\"uid\",
        \"groups\":\"memberOf\",
        \"email\":\"mail\",
        \"firstname\":\"displayname\",
        \"lastname\":\"\",
        \"phone\":\"telephoneNumber\",
        \"jobTitle\":\"title\"
        \"jobLevel\":\"level\"
        \"department\":\"department\"

}"

# For AD use these default attributes
# JULIANNA_LDAP_KEYS="{
#        \"username\":\"cn\",
#        \"groups\":\"memberOf\",
#        \"email\":\"mail\",
#        \"firstname\":\"givenName\",
#        \"lastname\":\"sn\",
#        \"phone\":\"telephoneNumber\",
#        \"jobTitle\":\"title\"
#        \"jobLevel\":\"level\"
#        \"department\":\"department\"
#      }"

JULIANNA_LDAP_DEFAULT_ROLE_KEY = 20                   # Default Julianna Role on creation. (set to editor)

# Default role assignments upon first login.
# optional - Can be updated later in user settings for each user
JULIANNA_LDAP_GROUP_ASSIGNMENT="{
               \"5\": {
                 \"ltRole\":\"readonly\",
                 \"ldapRole\":\"readonly\"
               },
               \"10\": {
                 \"ltRole\":\"commenter\",
                  \"ldapRole\":\"commenter\"
               },
               \"20\": {
                 \"ltRole\":\"editor\",
                  \"ldapRole\":\"editor\"
               },
               \"30\": {
                 \"ltRole\":\"manager\",
                  \"ldapRole\":\"manager\"
               },
               \"40\": {
                 \"ltRole\":\"admin\",
                  \"ldapRole\":\"administrators\"
               },
               \"50\": {
                 \"ltRole\":\"owner\",
                 \"ldapRole\":\"administrators\"
               }
}"

## OpenID Connect
# required
JULIANNA_OIDC_ENABLE = false
JULIANNA_OIDC_CLIENT_ID =
JULIANNA_OIDC_CLIENT_SECRET =

# required - the URL for your provider (examples down below)
#JULIANNA_OIDC_PROVIDER_URL =

#Create User if it doesn't exist in Julianna db, otherwise fail login
JULIANNA_OIDC_CREATE_USER = false

# Default role for users created via OIDC (20 is editor)
JULIANNA_OIDC_DEFAULT_ROLE = 20

# optional - these will be read from the well-known configuration if possible
#JULIANNA_OIDC_AUTH_URL_OVERRIDE =
#JULIANNA_OIDC_TOKEN_URL_OVERRIDE =
#JULIANNA_OIDC_JWKS_URL_OVERRIDE =
#JULIANNA_OIDC_USERINFO_URL_OVERRIDE =

# optional - override the public key for RSA validation
#JULIANNA_OIDC_CERTIFICATE_STRING =
#JULIANNA_OIDC_CERTIFICATE_FILE =

# optional - override the requested scopes
#JULIANNA_OIDC_SCOPES =

# optional - override the keys used for these fields
#JULIANNA_OIDC_FIELD_EMAIL =
#JULIANNA_OIDC_FIELD_FIRSTNAME =
#JULIANNA_OIDC_FIELD_LASTNAME =
#JULIANNA_OIDC_FIELD_PHONE =
#JULIANNA_OIDC_FIELD_JOBTITLE =
#JULIANNA_OIDC_FIELD_JOBLEVEL=
#JULIANNA_OIDC_FIELD_DEPARTMENT =

## OpenID Connect setting for GitHub
#JULIANNA_OIDC_PROVIDER_URL = https://token.actions.githubusercontent.com/
#JULIANNA_OIDC_AUTH_URL_OVERRIDE = https://github.com/login/oauth/authorize
#JULIANNA_OIDC_TOKEN_URL_OVERRIDE = https://github.com/login/oauth/access_token
#JULIANNA_OIDC_USERINFO_URL_OVERRIDE = https://api.github.com/user,https://api.github.com/user/emails
#JULIANNA_OIDC_SCOPES = user:email,read:user
#JULIANNA_OIDC_FIELD_EMAIL = 0.email
#JULIANNA_OIDC_FIELD_FIRSTNAME = name


## Redis (for session storage and cache)
JULIANNA_USE_REDIS = false                             # Set to true to use redis as session cache
JULIANNA_REDIS_URL = ''                                # Add URL path such as tcp://1.2.3.4:6379. If you are using a password, add ?auth=yourverycomplexpasswordhere to your URL
JULIANNA_REDIS_HOST = ''
JULIANNA_REDIS_PORT = 6379
JULIANNA_REDIS_PASSWORD = ''
JULIANNA_REDIS_SCHEME = ''
JULIANNA_REDIS_SESSION_DB = 1                          # Redis database for SESSIONS. Set this to a different DB than the cache connection (JULIANNA_REDIS_DB, default 0) so cache FLUSHDB can never log users out. Non-cluster setups only.

## Rate limiting
JULIANNA_RATELIMIT_GENERAL = 2000                           # Cron (/cron) and other non-API requests routed through the limiter
JULIANNA_RATELIMIT_API = 120                                # API (JSON-RPC) requests; 2 req/s sustained
JULIANNA_RATELIMIT_AUTH = 20                                # Login attempts — keep low (brute-force protection)
JULIANNA_RATELIMIT_MCP = 300                                # MCP endpoint requests; shares the same limiter key as API/general
JULIANNA_RATELIMIT_SIGNUP = 5                               # Public signup attempts per IP per hour
JULIANNA_RATELIMIT_INVITES_USER = 10                        # User invites per inviting user per HOUR
JULIANNA_RATELIMIT_INVITES_TENANT = 30                      # User invites per installation per DAY (raise for bulk onboarding/imports)
